---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const dicas = (await getCollection('dicas')).slice(0, 3);

const todasNoticias = await getCollection('noticias');
type Noticia = (typeof todasNoticias)[number];

const publicationTimestamp = (noticia: Noticia) => {
  const [hours, minutes] = noticia.data.publishedTime?.split(':').map(Number) ?? [0, 0];

  return noticia.data.publishedAt.valueOf() + ((hours * 60 + minutes) * 60_000);
};

const noticias = todasNoticias
  .sort((a, b) => publicationTimestamp(b) - publicationTimestamp(a))
  .slice(0, 3);

// Datas YYYY-MM-DD representam calendário editorial, não horário local.
const dateFormatter = new Intl.DateTimeFormat('pt-BR', { timeZone: 'UTC' });

const formatPublication = (noticia: Noticia) =>
  `${dateFormatter.format(noticia.data.publishedAt)}${noticia.data.publishedTime ? ` · ${noticia.data.publishedTime} BRT` : ''}`;
---

<BaseLayout title="Cibersegurança para pessoas reais" description="O MindHack Sec transforma cibersegurança em escolhas digitais mais seguras.">
  <section class="hero">
    <div>
      <p class="eyebrow">Cibersegurança sem complicação</p>
      <h1>Conhecimento é a melhor <em>camada de defesa.</em></h1>
      <p class="lead">O MindHack Sec traduz o universo da segurança da informação em conteúdo claro, prático e responsável — para você navegar com mais segurança.</p>
      <div class="actions"><a class="button" href="/dicas">Explorar dicas</a><a class="button button-secondary" href="/sobre">Conheça o projeto</a></div>
    </div>
    <div class="terminal" aria-label="Ilustração decorativa de terminal">
      <div class="terminal-top"><i></i><i></i><i></i></div>
      <p><span>mindhack@sec</span>:~$ aprender --com-segurança</p>
      <p>→ Senhas fortes</p><p>→ Privacidade digital</p><p>→ Pensamento crítico</p>
      <p><span>status:</span> mais seguro a cada escolha <b class="cursor"></b></p>
    </div>
  </section>

  {noticias.length > 0 && (
    <section class="section latest-news" aria-labelledby="latest-news-title">
      <div class="section-inner">
        <div class="section-header">
          <div><p class="eyebrow">Informação com contexto</p><h2 id="latest-news-title">Últimas notícias</h2></div>
          <a href="/noticias">Todas as notícias →</a>
        </div>
        <div class="news-grid" role="region" aria-label="Notícias recentes" tabindex="0">
          {noticias.map((noticia) => (
            <article class="card news-card">
              <p class="article-meta">{formatPublication(noticia)}</p>
              <h3>{noticia.data.title}</h3>
              <p>{noticia.data.description}</p>
              <div class="tag-list" aria-label="Assuntos da notícia">
                {noticia.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <a class="card-link" href={`/noticias/${noticia.id}`}>Ler notícia →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-alternate">
    <div class="section-inner"><div class="section-header"><div><p class="eyebrow">Comece por aqui</p><h2>Dicas para o seu dia a dia digital</h2></div><a href="/dicas">Todas as dicas →</a></div>
      <div class="card-grid">{dicas.map((dica) => <article class="card"><span class="tag">{dica.data.level}</span><h3>{dica.data.title}</h3><p>{dica.data.description}</p><a class="card-link" href={`/dicas/${dica.id}`}>Ler dica →</a></article>)}</div>
    </div>
  </section>

  <section id="youtube" class="section"><div class="youtube-panel"><div><p class="eyebrow">Canal oficial</p><h2>Entre no submundo dos dados.</h2><p>O MindHack Sec está no YouTube. Acompanhe o canal para receber os primeiros vídeos e as próximas trilhas de aprendizagem.</p></div><a class="button button-secondary" href="https://www.youtube.com/@MindHackSec" target="_blank" rel="noopener noreferrer">Conhecer o canal <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
